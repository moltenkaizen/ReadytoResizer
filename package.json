{
  "name": "ReadyToResizer",
  "version": "1.0.0",
  "description": "Figma plugin that frames selected images with locked aspect ratios and stretch constraints, making high-DPI screenshots easy to resize to logical dimensions",
  "main": "code.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "test": "npm run build && node --test",
    "watch": "npm run build -- --watch"
  },
  "author": "Stephen Fox",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@figma/eslint-plugin-figma-plugins": "^1.0.0",
    "@figma/plugin-typings": "^1.121.0",
    "eslint": "^9.39.4",
    "typescript": "^5.3.2",
    "typescript-eslint": "^8.61.0"
  }
}
